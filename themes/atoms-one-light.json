{
  "$schema": "vscode://schemas/color-theme",
  "name": "Atom's One Light",
  "author": "namnkahn1607",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#eff1f5",
    "editor.foreground": "#383a42",
    "editorBracketHighlight.foreground1": "#383a42",
    "editorBracketHighlight.foreground2": "#383a42",
    "editorBracketHighlight.foreground3": "#383a42",
    "editorBracketHighlight.foreground4": "#383a42",
    "editorBracketHighlight.foreground5": "#383a42",
    "editorBracketHighlight.foreground6": "#383a42",
    "activityBar.background": "#eff1f5",
    "activityBar.foreground": "#121417",
    "activityBarBadge.background": "#1a85ff",
    "activityBarBadge.foreground": "#e6e9ef",
    "badge.background": "#1a85ff",
    "badge.foreground": "#eff1f5",
    "button.background": "#1a85ff",
    "button.foreground": "#eff1f5",
    "button.hoverBackground": "#1975ff",
    "dropdown.background": "#e6e9ef",
    "dropdown.border": "#dbdbdc",
    "editor.findMatchBackground": "#1a85ff66",
    "editor.findMatchHighlightBackground": "#1a85ff33",
    "editor.lineHighlightBackground": "#383a420c",
    "editor.selectionBackground": "#e6e8ec",
    "editor.wordHighlightTextBackground": "#1a85ff33",
    "editorCursor.foreground": "#1a85ff",
    "editorGroup.border": "#dbdbdc",
    "editorGroupHeader.tabsBackground": "#e6e9ef",
    "editorHoverWidget.background": "#e6e9ef",
    "editorHoverWidget.border": "#dbdbdc",
    "editorIndentGuide.activeBackground1": "#383a42cf",
    "editorIndentGuide.background1": "#383a4233",
    "editorInlayHint.background": "#eff1f5",
    "editorInlayHint.foreground": "#afb2bb",
    "editorLineNumber.foreground": "#9d9d9f",
    "editorLineNumber.activeForeground": "#383a42",
    "editorRuler.foreground": "#383a4233",
    "editorSuggestWidget.background": "#e6e9ef",
    "editorSuggestWidget.border": "#dbdbdc",
    "editorSuggestWidget.selectedBackground": "#dbdbdc",
    "editorWhitespace.foreground": "#383a4233",
    "editorWidget.background": "#e6e9ef",
    "extensionButton.prominentBackground": "#1a85ff",
    "extensionButton.prominentForeground": "#eff1f5",
    "extensionButton.prominentHoverBackground": "#1975ff",
    "focusBorder": "#1a85ff",
    "input.background": "#e6e9ef",
    "input.border": "#dbdbdc",
    "list.activeSelectionBackground": "#383a4220",
    "list.activeSelectionForeground": "#121417",
    "list.focusBackground": "#383a4220",
    "list.hoverBackground": "#383a420d",
    "list.highlightForeground": "#121417",
    "list.inactiveSelectionBackground": "#383a4220",
    "list.inactiveSelectionForeground": "#121417",
    "peekView.border": "#1a85ff",
    "peekViewEditor.background": "#e6e9ef",
    "peekViewResult.background": "#e6e9ef",
    "peekViewResult.selectionBackground": "#e6e8ec",
    "peekViewTitle.background": "#e6e9ef",
    "pickerGroup.border": "#1a85ff",
    "scrollbarSlider.activeBackground": "#383a4250",
    "scrollbarSlider.background": "#383a4270",
    "scrollbarSlider.hoverBackground": "#383a4260",
    "sideBar.background": "#eff1f5",
    "sideBarSectionHeader.background": "#eff1f5",
    "statusBar.background": "#e6e9ef",
    "statusBar.debuggingForeground": "#e6e9ef",
    "statusBar.foreground": "#121417",
    "statusBar.noFolderBackground": "#e6e9ef",
    "statusBarItem.hoverBackground": "#dbdbdc",
    "tab.activeBackground": "#eff1f5",
    "tab.activeForeground": "#121417",
    "tab.border": "#dbdbdc",
    "tab.inactiveBackground": "#e6e9ef",
    "titleBar.activeBackground": "#e6e9ef",
    "titleBar.activeForeground": "#121417",
    "titleBar.inactiveBackground": "#e6e9ef",
    "titleBar.inactiveForeground": "#121417",
    "gitDecoration.addedResourceForeground": "#40a02b",
    "gitDecoration.conflictingResourceForeground": "#d4264b",
    "gitDecoration.modifiedResourceForeground": "#1e66f5",
    "gitDecoration.renamedResourceForeground": "#df8e1d",
    "gitDecoration.deletedResourceForeground": "#acb0be",
    "gitDecoration.untrackedResourceForeground": "#40a02b",
    "gitDecoration.ignoredResourceForeground": "#8e8e90",
    "gitDecoration.stageDeletedResourceForeground": "#d4264b",
    "gitDecoration.stageModifiedResourceForeground": "#8839ef",
    "gitDecoration.submoduleResourceForeground": "#acb0be"
  },
  "semanticTokenColors": {
    "bracket": "#383a42",
    "class": "#df8e1d",
    "class.constructorOrDestructor": "#4078f2",
    "class.deduced": "#a626a4",
    "enum": "#df8e1d",
    "enum.deduced": "#a626a4",
    "enumMember": "#383a42",
    "function": "#4078f2",
    "interface": "#df8e1d",
    "label": "#383a42",
    "macro": "#4078f2",
    "method": "#4078f2",
    "modifier": "#a626a4",
    "namespace": "#383a42",
    "operator": "#e45649",
    "parameter": "#0184bc",
    "property": "#383a42",
    "struct": "#df8e1d",
    "type": "#df8e1d",
    "type.deduced": "#a626a4",
    "type.defaultLibrary.fileScope": "#a626a4",
    "typeParameter": "#df8e1d",
    "variable": "#383a42"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#383a42"
      }
    },
    {
      "name": "affix",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name",
        "support.other.attribute"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a0a1a7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "declarator",
      "scope": [
        "storage.modifier.pointer",
        "storage.modifier.reference"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "enumMember",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#383a42"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ca1243"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "constant.language",
        "entity.name.operator.type",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "storage.type",
        "variable.language"
      ],
      "settings": {
        "foreground": "#a626a4"
      }
    },
    {
      "name": "macro",
      "scope": [
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#4078f2"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "name": "operator",
      "scope": [
        "entity.name.operator",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e45649"
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#0184bc"
      }
    },
    {
      "name": "placeholder",
      "scope": [
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#ca1243"
      }
    },
    {
      "name": "plain",
      "scope": [
        "punctuation.section.attribute",
        "variable.parameter.capture",
        "variable.parameter.preprocessor"
      ],
      "settings": {
        "foreground": "#383a42"
      }
    },
    {
      "name": "string",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#50a14f"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#df8e1d"
      }
    }
  ]
}
