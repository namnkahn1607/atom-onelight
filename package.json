{
  "name": "atoms-one-light",
  "displayName": "Atom's One Light",
  "description": "A personal light color theme, inspired by Atom's One Dark.",
  "version": "0.0.1",
  "publisher": "namnkahn1607",
  "author": "namnkahn1607",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/namnkahn1607/atom-onelight"
  },
  "contributes": {
    "themes": [
      {
        "label": "Atom's One Light",
        "uiTheme": "vs",
        "path": "./themes/atoms-one-light.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "icon": "tsx utils/logo.ts",
    "check": "tsc --noEmit",
    "package": "npm run build && npm run icon && vsce package --skip-license"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
